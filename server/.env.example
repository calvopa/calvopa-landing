# URL del webhook de n8n que recibe el submit del formulario de contacto.
# Ya armado: workflow "Calvopa — Contacto web" en n8n personal (n8n.calvopa.net),
# Webhook -> Google Sheets (Append Row) a la planilla "Calvopa — Contactos".
N8N_WEBHOOK_URL=https://n8n.calvopa.net/webhook/calvopa-contact

# Opcional: header compartido para verificar que el request viene de acá.
# Si lo seteás, agregá la misma validación en el nodo Webhook de n8n
# (Header Auth, header X-Webhook-Secret).
N8N_WEBHOOK_SECRET=

# Puerto interno del contenedor (no hace falta tocarlo normalmente).
PORT=3001

# Solo necesario si probás el frontend en un origen distinto al proxy
# de nginx (por ejemplo, abriendo index.html directo o con otro puerto
# local). En producción, detrás de nginx, se puede dejar vacío.
ALLOWED_ORIGIN=
